# --- Database (local placeholder; swap for the real Supabase Postgres URL later) ---
# `make test` runs against a SEPARATE database (`make test-db` creates/migrates
# it) -- never this one. Tests truncate tables on teardown.
DATABASE_URL=postgresql://bellz:AdminPassword19@localhost:5432/ai-leads-research-outreach-agent-db

# --- Claude Agent SDK ---
ANTHROPIC_API_KEY=

# --- Supabase Auth (OTP flow) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# No JWT secret needed: access tokens are verified against Supabase's JWKS
# endpoint (derived from SUPABASE_URL), since new projects sign asymmetrically.
# Resend is ALSO configured as Supabase's custom SMTP provider in the Supabase
# dashboard (Auth -> Settings -> SMTP Settings), for OTP emails specifically --
# that's separate from the direct Resend calls below.

# --- App session ---
APP_SESSION_TTL_MINUTES=60

# --- Vague-objective rate limiting ---
VAGUE_OBJECTIVE_MAX_ATTEMPTS=3
VAGUE_OBJECTIVE_COOLDOWN_MINUTES=30

# --- Apify (not used yet -- Milestone 2) ---
APIFY_API_TOKEN=

# --- Resend (direct calls -- access-granted notification emails only) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
APP_URL=http://localhost:3000

# --- CORS ---
# Comma-separated list of origins allowed to call the API from a browser.
# Defaults (see config.py) already cover local dev + the deployed frontend,
# so this only needs setting if that origin ever changes (custom domain,
# new Vercel project) -- update it on Render, not by editing the default.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ai-lead-research-outreach-agent.vercel.app

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
